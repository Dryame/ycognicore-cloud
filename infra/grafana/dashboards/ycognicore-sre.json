{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "timeseries",
      "title": "1. Latence HTTP (p50 / p95 / p99)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))", "legendFormat": "p99" }
      ]
    },
    {
      "type": "timeseries",
      "title": "2. Trafic - Requetes par seconde",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 } },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count[1m]))", "legendFormat": "total" },
        { "expr": "sum by (uri) (rate(http_server_requests_seconds_count[1m]))", "legendFormat": "{{uri}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "3. Taux d'erreur HTTP (4xx / 5xx)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "targets": [
        { "expr": "100 * sum(rate(http_server_requests_seconds_count{status=~\"4..\"}[5m])) / sum(rate(http_server_requests_seconds_count[5m]))", "legendFormat": "4xx %" },
        { "expr": "100 * sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count[5m]))", "legendFormat": "5xx %" }
      ]
    },
    {
      "type": "timeseries",
      "title": "4. Threads Tomcat (busy / current / max)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 } },
      "targets": [
        { "expr": "tomcat_threads_busy_threads", "legendFormat": "busy" },
        { "expr": "tomcat_threads_current_threads", "legendFormat": "current" },
        { "expr": "tomcat_threads_config_max_threads", "legendFormat": "max" }
      ]
    },
    {
      "type": "timeseries",
      "title": "5. Memoire Heap JVM",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 } },
      "targets": [
        { "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "used" },
        { "expr": "sum(jvm_memory_max_bytes{area=\"heap\"})", "legendFormat": "max" },
        { "expr": "sum(jvm_memory_committed_bytes{area=\"heap\"})", "legendFormat": "committed" }
      ]
    },
    {
      "type": "timeseries",
      "title": "6. Garbage Collector - Pauses",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 } },
      "targets": [
        { "expr": "rate(jvm_gc_pause_seconds_sum[1m]) / rate(jvm_gc_pause_seconds_count[1m])", "legendFormat": "pause avg" },
        { "expr": "rate(jvm_gc_pause_seconds_sum[1m])", "legendFormat": "pause total /s" }
      ]
    },
    {
      "type": "timeseries",
      "title": "7. CPU (process / system)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 } },
      "targets": [
        { "expr": "process_cpu_usage", "legendFormat": "process" },
        { "expr": "system_cpu_usage", "legendFormat": "system" }
      ]
    },
    {
      "type": "timeseries",
      "title": "8. Threads JVM (live / daemon / peak)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 } },
      "targets": [
        { "expr": "jvm_threads_live_threads", "legendFormat": "live" },
        { "expr": "jvm_threads_daemon_threads", "legendFormat": "daemon" },
        { "expr": "jvm_threads_peak_threads", "legendFormat": "peak" }
      ]
    },
    {
      "type": "timeseries",
      "title": "9. HikariCP - Connexions DB",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 } },
      "targets": [
        { "expr": "hikaricp_connections_active", "legendFormat": "active" },
        { "expr": "hikaricp_connections_idle", "legendFormat": "idle" },
        { "expr": "hikaricp_connections_pending", "legendFormat": "pending" },
        { "expr": "hikaricp_connections_max", "legendFormat": "max" }
      ]
    },
    {
      "type": "timeseries",
      "title": "10. SQL - Acquisition & usage connexion",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 } },
      "targets": [
        { "expr": "rate(hikaricp_connections_acquire_seconds_sum[1m]) / rate(hikaricp_connections_acquire_seconds_count[1m])", "legendFormat": "acquire avg" },
        { "expr": "rate(hikaricp_connections_usage_seconds_sum[1m]) / rate(hikaricp_connections_usage_seconds_count[1m])", "legendFormat": "usage avg" }
      ]
    }
  ],
  "refresh": "10s",
