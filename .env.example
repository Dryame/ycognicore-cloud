# ============================================================================
# yCogniCore Cloud — Variables d'environnement
# ============================================================================
# Copier ce fichier vers .env et remplacer les valeurs "change-me".
#
#   cp .env.example .env
#   # puis éditer .env
#
# IMPORTANT : .env est exclu du dépôt (.gitignore). Ne jamais commiter .env.
# ============================================================================

# --- PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/ycc_control_plane
DB_USERNAME=postgres
DB_PASSWORD=change-me
PG_HOST=localhost
PG_PORT=5432
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=change-me
CONTROL_PLANE_DB=ycc_control_plane

# --- Vault (gestion des secrets) ---
VAULT_URL=http://localhost:8200
VAULT_TOKEN=change-me

# --- JWT (HS512 : clé ≥ 64 octets / 512 bits) ---
JWT_SECRET=change-me-at-least-64-characters-long-for-hs512-signing-xxxxxxxxxxxxxx

# --- MinIO (stockage objet) ---
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me

# --- Profil Spring actif (dev ou prod) ---
SPRING_PROFILES_ACTIVE=dev
